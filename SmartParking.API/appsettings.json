{
  "Jwt": {
    "Key": "CHANGE_ME_WITH_A_32_CHARACTER_SECRET",
    "Issuer": "SmartParkingAPI",
    "Audience": "SmartParkingClient",
    "ExpireMinutes": 60
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=SmartParkingDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Database": {
    "Provider": "SqlServer",
    "ApplyMigrationsOnStartup": true,
    "UseEnsureCreated": false
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "Sensor": {
    "IngestKey": ""
  },

"Camera": {
    "WebhookKey": ""
  },

  "DocumentDb": {
    "ConnectionString": "",
    "DatabaseName": "smartparking-telemetry",
    "SensorReadingsRetentionDays": 365,
    "AnprRetentionDays": 730
  },

  "Anpr": {
    "TensorRtBaseUrl": "",
    "TensorRtApiKey": ""
  },

  "Payment": {
    "Provider": "disabled",
    "ApiKey": "",
    "SecretKey": "",
    "BaseUrl": "https://sandbox-api.iyzipay.com",
    "CallbackBaseUrl": "",
    "ReturnScheme": "smartparking://payment-result"
  },

  "Firebase": {
    "Enabled": false,
    "ProjectId": "",
    "ServiceAccountJson": ""
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
